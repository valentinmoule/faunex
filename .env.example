# ---------------------------------------------------------------------------
# Frontend (Vite) — publishable values only, safe to ship to the browser
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Paddle client-side token. Prefix decides the environment:
#   test_...  -> sandbox   |   live_...  -> production
# .env.development holds the test token, .env.production the live one.
VITE_PAYMENTS_CLIENT_TOKEN="test_xxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Server-side secrets (edge function environment — never exposed to clients)
# ---------------------------------------------------------------------------
# Paddle API keys (one per environment), used via the connector gateway.
PADDLE_SANDBOX_API_KEY="pdl_sdbx_apikey_..."
PADDLE_LIVE_API_KEY="pdl_live_apikey_..."

# Webhook NOTIFICATION SIGNING SECRETS — these are NOT the API keys.
# Found on the notification destination (Developer tools > Notifications).
# Used by paddle.webhooks.unmarshal(rawBody, secret, signature).
PAYMENTS_SANDBOX_WEBHOOK_SECRET="pdl_ntfset_..."
PAYMENTS_LIVE_WEBHOOK_SECRET="pdl_ntfset_..."

# Lovable gateway key used to route Paddle API calls server-side.
LOVABLE_API_KEY="..."

# Injected automatically in the edge function runtime.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
